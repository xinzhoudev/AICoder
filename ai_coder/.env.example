# Copy to .env and adjust. Real environment variables take precedence.

# Which model server to use: ollama (default), openai (any OpenAI-compatible server) or mock (offline test double)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
# Default for ollama: http://localhost:11434   default for openai: http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=not-needed
LLM_TEMPERATURE=0.2
# Context window requested from Ollama (prompts for the coder/debugger can be long)
LLM_NUM_CTX=16384
LLM_TIMEOUT=900
# Retries for HTTP 429 / 5xx (free tiers hit rate limits)
LLM_MAX_RETRIES=4
# Sent as reasoning_effort to OpenAI-compatible servers when set (leave empty for Ollama)
LLM_REASONING_EFFORT=

# ---- Google Gemini instead of Ollama: uncomment these four lines ----
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-key-from-aistudio.google.com
# LLM_MODEL=<a Flash model id from the model list, see README>
# LLM_REASONING_EFFORT=low

# Pipeline limits (bound token usage)
MAX_FIX_ROUNDS=2
TEST_TIMEOUT=120
MAX_REPORT_CHARS=3500

# Stamped as a header comment on every generated Python file
AUTHOR_NAME=Xin Zhou & Yuxiao Xiao
STUDENT_ID=42742822 & 62185048
